PORT=8794
# Required, at least 16 characters. Guards every write endpoint.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Dev only: lets monitors target localhost / private ranges.
ALLOW_PRIVATE_TARGETS=true
# Optional: declare remote probes up front (region:token, comma separated).
# Each agent then runs with PROBE_TOKEN set to its token. Probes can also be
# created at runtime from the Manage dialog.
PROBE_TOKENS=eu-west:change-me-eu-west-token,us-east:change-me-us-east-token
# Name the built-in probe votes as, or LOCAL_PROBE=false to rely on agents only.
LOCAL_REGION=local
# Optional: sign outgoing webhooks (x-veghe-signature) with this shared secret.
# WEBHOOK_SECRET=change-me-to-a-long-random-string
